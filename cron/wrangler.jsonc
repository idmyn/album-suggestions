{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "david-place-cron",
  "main": "./index.ts",
  "compatibility_date": "2025-10-11",
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": [
      //"0 0 * * 5", // 00:00 on Friday
      "*/5 * * * *",
    ],
  },
  "vars": {
    "HONEYCOMB_DATASET": "david.place",
    "SERVICE_NAME": "cloudflare-cron-worker",
    "OTEL_ENABLED": "true",
  },
}
