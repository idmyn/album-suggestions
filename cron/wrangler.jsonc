{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "david-place-cron",
  "main": "./index.ts",
  "compatibility_date": "2025-10-11",
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": [
      "0 0 * * FRI", // 00:00 on Friday
      //"*/2 * * * *",
    ],
  },
  "vars": {
    "OTEL_ENABLED": "true",
  },
}
