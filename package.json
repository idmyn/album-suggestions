{
	"name": "album-suggestions",
	"private": true,
	"workspaces": {
		"packages": [
			"website",
			"cron",
			"shared"
		],
		"catalogs": {
			"effect": {
				"@effect/ai": "^0.31.0",
				"@effect/ai-openrouter": "^0.5.0",
				"@effect/platform": "^0.94.0",
				"@effect/experimental": "^0.58.0",
				"@effect/sql": "^0.49.0",
				"@effect/sql-drizzle": "^0.48.0",
				"@effect/sql-libsql": "^0.39.0",
				"effect": "^3.19.13"
			},
			"drizzle": {
				"@libsql/client": "^0.15.15",
				"drizzle-orm": "^0.44.6"
			}
		}
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"devDependencies": {
		"@effect/language-service": "^0.44.0",
		"@types/bun": "latest",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"wrangler": "^4.42.2"
	},
	"scripts": {
		"prepare": "effect-language-service patch",
		"tsc": "bun --workspaces run tsc",
		"format": "prettier --write .",
		"deploy": "bun run deploy.ts",
		"build": "bun run --cwd website build",
		"start:website": "bun run website/build/index.js",
		"start:cron": "bun run cron/scripts/run.ts",
		"db:migrate": "bun run --cwd shared db:migrate"
	},
	"dependencies": {
		"@effect/opentelemetry": "^0.58.0",
		"@effect/platform": "catalog:effect",
		"@effect/platform-bun": "^0.87.0",
		"@opentelemetry/api": "^1.9.0",
		"effect": "catalog:effect"
	}
}
